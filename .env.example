# =============================================================================
# n8n AI Stack Deployer — plantilla completa de variables
# =============================================================================
# Copia a .env en tu N8N_BASE_DIR (p. ej. /home/devops/n8n/.env):
#   cp .env.example /home/devops/n8n/.env
# Rellena contraseñas y claves. NUNCA subas .env a git.
# Tras editar: sudo bash n8n-deployer.sh reconfigure
# =============================================================================

# -----------------------------------------------------------------------------
# Instalación y dominio (requerido para install / certbot)
# -----------------------------------------------------------------------------
DOMAIN=marrso.com
SUBDOMAIN=n8n
SSL_EMAIL=admin@marrso.com
FQDN=n8n.marrso.com

# -----------------------------------------------------------------------------
# URL pública y proxy
# N8N_PROXY_HOPS: 1 = DNS only (Cloudflare gris), 2 = proxy naranja
# -----------------------------------------------------------------------------
N8N_HOST=n8n.marrso.com
N8N_LISTEN_ADDRESS=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.marrso.com/
N8N_EDITOR_BASE_URL=https://n8n.marrso.com
N8N_PROXY_HOPS=2

# -----------------------------------------------------------------------------
# Base de datos PostgreSQL (mín. 12 caracteres)
# POSTGRES_PASSWORD = contraseña del contenedor postgres
# DB_POSTGRESDB_PASSWORD = misma contraseña (consumida por n8n)
# -----------------------------------------------------------------------------
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=CambiaEstaContraseñaPostgres12+
POSTGRES_PASSWORD=CambiaEstaContraseñaPostgres12+

# -----------------------------------------------------------------------------
# Redis / cola Bull (mín. 12 caracteres)
# -----------------------------------------------------------------------------
QUEUE_BULL_REDIS_HOST=redis
QUEUE_BULL_REDIS_PORT=6379
QUEUE_BULL_REDIS_PASSWORD=CambiaEstaContraseñaRedis12+
REDIS_PASSWORD=CambiaEstaContraseñaRedis12+

# -----------------------------------------------------------------------------
# Seguridad n8n
# N8N_ENCRYPTION_KEY: generada en install; NO cambiar en producción sin migrar
# -----------------------------------------------------------------------------
N8N_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Modo cola y workers (Community)
# -----------------------------------------------------------------------------
EXECUTIONS_MODE=queue
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true
N8N_WORKER_REPLICAS=3
N8N_REINSTALL_MISSING_PACKAGES=false

# Binarios: filesystem evita inflar binary_data en Postgres (recomendado RAG/WhatsApp)
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# Poda de ejecuciones (reduce disco en Postgres)
N8N_EXECUTIONS_DATA_PRUNE=true
N8N_EXECUTIONS_DATA_MAX_AGE=168
N8N_EXECUTIONS_DATA_PRUNE_MAX_COUNT=5000

EXECUTIONS_TIMEOUT=300
EXECUTIONS_TIMEOUT_MAX=600

# -----------------------------------------------------------------------------
# Runtime n8n
# -----------------------------------------------------------------------------
N8N_SECURE_COOKIE=true
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console
N8N_METRICS=true
N8N_METRICS_INCLUDE_QUEUE_METRICS=true
N8N_DIAGNOSTICS_ENABLED=false
GENERIC_TIMEZONE=America/Bogota

# -----------------------------------------------------------------------------
# Versiones Docker (opcional; el deployer tiene defaults)
# -----------------------------------------------------------------------------
N8N_VERSION=2.23.2

# -----------------------------------------------------------------------------
# Perfiles Docker Compose
# -----------------------------------------------------------------------------
ENABLE_QDRANT=true
ENABLE_MINIO=false
ENABLE_MONITORING=false

# Qdrant (si ENABLE_QDRANT=true)
QDRANT_URL=http://qdrant:6333

# MinIO (solo si ENABLE_MINIO=true)
# MINIO_ROOT_USER=admin
# MINIO_ROOT_PASSWORD=

# Monitoring (solo si ENABLE_MONITORING=true)
# GRAFANA_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Backups (deployer)
# BACKUP_ENABLED se controla en el script; retención y exclusiones en .env
# -----------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=2
BACKUP_EXCLUDE_BINARY_DATA=true
BACKUP_EXCLUDE_EXECUTIONS=true
BACKUP_QDRANT=true

# -----------------------------------------------------------------------------
# nginx (deployer)
# -----------------------------------------------------------------------------
ENABLE_NGINX_RATE_LIMIT=false
NGINX_RATE_LIMIT=30
ENABLE_N8N_CSP=false

# -----------------------------------------------------------------------------
# SSL (deployer)
# -----------------------------------------------------------------------------
AUTO_SSL=true

# -----------------------------------------------------------------------------
# Claves IA opcionales (nodos AI Agent, embeddings, etc.)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# CLAUDE_API_KEY=
# GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# SMTP opcional (invitaciones owner / reset password)
# -----------------------------------------------------------------------------
# N8N_EMAIL_MODE=smtp
# N8N_SMTP_HOST=smtp.example.com
# N8N_SMTP_PORT=587
# N8N_SMTP_USER=
# N8N_SMTP_PASS=
# N8N_SMTP_SENDER=noreply@marrso.com
